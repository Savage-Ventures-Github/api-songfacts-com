{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "songfacts-api-interest-submission",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
